# Sorties du pipeline DVC : aucune conversion de fin de ligne par Git.
# dvc.lock enregistre le hash MD5 exact de ces fichiers ; une conversion CRLF<->LF au
# checkout (Windows vs Linux/CI) ferait croire à DVC qu'ils ont changé.
data/**/*.json -text
data/**/*.md -text
reports/** -text
*.ipynb -text

# Code suivi comme entrée du pipeline DVC : toujours en LF, pour que son MD5 soit le même
# sur un clone Windows (core.autocrlf=true) que dans dvc.lock et sur la CI Linux.
src/*.py text eol=lf
scripts/*.py text eol=lf
